# Database Configuration
POSTGRES_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/feedback

# API Configuration
API_PORT=3000

# Web Configuration
WEB_PORT=80

# Application Configuration
LOG_ENABLED=true
LOG_LEVEL=info
