# Database Configuration
# WARNING: Change these default values before deploying to production!
POSTGRES_DB=feedback
POSTGRES_USER=postgres
# SECURITY: Use a strong password - generate with: openssl rand -base64 32
POSTGRES_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/feedback

# Node Environment
NODE_ENV=production

# API Configuration
API_PORT=3000

# Web Configuration
WEB_PORT=80

# Application Configuration
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FOR_HUMANS_FORMAT=false
DEBUG_ENABLED=false

# Password hash
PASSWORD_HASH=10

# Token configuration
# IMPORTANT: Change this to a strong random secret in production!
# Generate a secure secret with: openssl rand -base64 32
TOKEN_SECRET=change-this-secret-in-production
TOKEN_EXPIRATION=1h

# Emailing
MAILING_ENABLED=false
MAIL_TEST_ACCOUNT_ENABLED=false
MAILING_SERVICE=
MAILING_SECURE=false
MAILING_PORT=587
MAILING_USER=
MAILING_PASSWORD=

# Base URL
# IMPORTANT: Update this to the public URL of your deployed application in production
# Example: https://feedback.example.com
# IMPORTANT: Update this to the public URL of your deployed application in production
# Example: https://feedback.example.com
BASE_URL=http://localhost
