{
  "name": "api",
  "version": "1.0.0",
  "description": "The api of Feedback plateforme",
  "homepage": "https://github.com/metro-connexion/feedback#readme",
  "bugs": {
    "url": "https://github.com/metro-connexion/feedback/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metro-connexion/feedback.git"
  },
  "license": "MIT",
  "author": "metro-connexion",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "npm run db:prepare:dev && nodemon index.js",
    "test:unit": "cross-env NODE_ENV=test vitest run --project 'Unit tests'",
    "test:integration": "npm run test:prepare && cross-env NODE_ENV=test vitest run --project 'Integration tests'",
    "test:acceptance": "npm run test:prepare && cross-env NODE_ENV=test vitest run --project 'Acceptance tests'",
    "test": "npm run test:prepare && cross-env NODE_ENV=test vitest run",
    "test:prepare": "cross-env NODE_ENV=test npm run db:prepare",
    "start": "node index.js",
    "db:new-migration": "npx knex --knexfile ./db/knexfile.js  migrate:make --stub $PWD/db/template.js $migrationname",
    "db:create": "node ./db/create-database.js",
    "db:delete": "node ./db/drop-database.js",
    "db:empty": "node db/empty-database.js",
    "db:migrate": "knex --knexfile ./db/knexfile.js  migrate:latest",
    "db:rollback:latest": "knex --knexfile ./db/knexfile.js  migrate:down",
    "db:prepare": "npm run db:delete && npm run db:create && npm run db:migrate",
    "db:prepare:dev": "npm run db:create && npm run db:migrate",
    "db:seed": "knex --knexfile ./db/knexfile.js seed:run",
    "db:reset": "npm run db:prepare && npm run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "cross-env": "^10.1.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-knex": "^0.2.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  }
}
