{
  "name": "feedback",
  "version": "1.0.0",
  "description": "Report feedback about metro-connexion services",
  "homepage": "https://github.com/metro-connexion/feedback#readme",
  "bugs": {
    "url": "https://github.com/metro-connexion/feedback/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metro-connexion/feedback.git"
  },
  "license": "MIT",
  "author": "metro-connexion",
  "type": "module",
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "lint:root": "eslint .",
    "lint:root:fix": "eslint --fix",
    "lint:api": "cd api && npm run lint",
    "lint": "run-p --print-label lint:root lint:api",
    "ci:api": "cd api && npm ci",
    "ci:all": "run-p --print-label ci:api",
    "test:api": "cd api && npm t",
    "test": "run-p --print-label test:*",
    "dev:api": "cd api && npm run dev",
    "dev": "run-p --print-label dev:*",
    "configure": "sh scripts/configure.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-yaml": "^1.1.3",
    "npm-run-all": "^4.1.5"
  }
}
